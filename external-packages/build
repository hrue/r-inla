#!/usr/bin/env bash

log_error () {
    echo -e "\x1b[48;5;124m\x1b[1;97m" "$@" "\x1b[0m" "\n"
}
log_info () {
    echo -e "\x1b[48;5;22m\x1b[1;97m" "$@" "\x1b[0m" "\n"
}
log_warning () {
    echo -e "\x1b[48;5;19m\x1b[1;97m" "$@" "\x1b[0m" "\n"
}

DD=""
for p in *; do
    if [ -d "$p" -a -f "$p/Makefile" ]; then
	log_info "Process package [$p]"
	(
	    cd $p
	    make download "$@"
	    find . -name cgeneric.h | while read f; do  mv -vf "$f" "$f"-disabled; done
	    make build "$@"
	) && {
	    log_info "Package [$p] OK and will be included"
	    DD="$p $DD"
	} || {
	    log_error "Package [$p] FAIL and will NOT be included"
	}
    fi
done

log_info "List of included package:"
for D in $DD; do
    echo -e "\t[$D]"
done
echo 

./update-cgeneric $DD

for D in $DD; do 
    (
	cd $D
	L=lib$D.a
	log_info "Create library [$D]"
	find . -name \*.o | while read f; do 
	    ar crvs $L "$f"
	done
	mv -v -f $L ..
    )
done
