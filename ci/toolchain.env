# Toolchain and dependency versions for the binaries CI builds.
#
# THIS FILE IS THE SINGLE SOURCE OF TRUTH. Edit the values here and both
# projects follow: r-inla's own lanes read it directly, and the sTiles CI
# (testcodesprojects/portable) fetches this exact file before building, so
# the solver ends up compiled with the same compiler, the same CPU target
# and the same numerical libraries as the inla binary it is linked into.
# That is what keeps the two halves from drifting apart.
#
# Format: plain KEY=VALUE, sourced by shell scripts. No command
# substitution, no logic -- keep it boring so it stays readable.

# ---- compiler -------------------------------------------------------------
# Preference order, highest first. The scripts install the newest one they
# can get and fall back down this list; a version that does not exist for a
# platform is simply skipped.
## ONE compiler, not a preference list. A list lets the two projects resolve
## differently on different runners, and then a bundle embeds a library built
## by another compiler without anything saying so. If this version is missing
## the build must fail loudly rather than quietly fall back.
GCC_PREFER="16"

## Same idea inside the manylinux container, which ships several gcc-toolsets
## and offers more from its repositories. Both projects enable THIS one. Left
## empty means "whatever the image ships", which is how the baseline x86_64
## bundle ended up built by gcc-toolset-15 around a libstiles built by 14.
GCC_TOOLSET="15"

## The MinGW-w64 triplet the Windows binaries are cross-built with. It selects
## a whole toolchain, not just a name: the C runtime (UCRT rather than the old
## msvcrt) and with it the libgcc, libgfortran and libgomp that end up in the
## same process. Both projects read it here so a change to the Windows
## toolchain moves both halves at once instead of leaving one behind.
MINGW_TRIPLET="x86_64-w64-mingw32ucrt"

# ---- CPU targets ----------------------------------------------------------
# The "modern" bundles compile every object for these; the classic Linux
# bundles stay at the portable baseline (no -march) so they run anywhere.
#   x86-64-v3  = AVX2 + FMA + BMI, any CPU from ~2015
#   armv8.2-a  = Graviton2+, Ampere Altra, Grace, RPi 5 (NOT RPi 4)
MARCH_X86_MODERN="-march=x86-64-v3 -mtune=generic"
MARCH_ARM_MODERN="-march=armv8.2-a -mtune=neoverse-n1"

# THE REAL x86 FLOOR OF A PAIRED BUNDLE. INLA's own code is baseline
# x86-64 (verified: no ymm instructions in the classic binary; it reaches
# AVX2 at run time through MKL and the CLONE_TARGETS clones). sTiles is
# different: its tile kernels are compiled for AVX2 outright, so ANY bundle
# that embeds libstiles needs an AVX2 CPU -- Intel Haswell (2013+) or AMD
# Excavator+ -- regardless of what INLA alone would run on. Set this to
# "generic" and rebuild sTiles if a pre-AVX2 machine ever has to be
# supported; the cost is sTiles' own vectorization, not the BLAS.
X86_ISA_FLOOR=avx2

# sTiles spells its CPU targets with short names; these map onto the two
# lines above (see make.inc: MARCH=avx2|avx512|armv82|native|generic).
STILES_MARCH_X86=avx2
STILES_MARCH_ARM=armv82

# ---- optimization ---------------------------------------------------------
# Both projects compile their own code with these. sTiles keeps its own
# -O3/-funroll-loops recipe; what has to agree is the CPU target above, the
# link-time optimization setting and the OpenMP runtime, because those three
# decide whether the two halves are compatible rather than merely similar.
OPT_LEVEL=3
# Link-time optimization: 1 enables it in both projects' release builds.
USE_LTO=1
# The OpenMP runtime BOTH sides must use. libstiles is loaded into the inla
# process, so two different runtimes in one process is the "OMP: Error #15"
# abort; GCC everywhere means GNU libgomp everywhere.
OPENMP_RUNTIME=gomp
# C++ standard library linkage. Static means a libstdc++ version difference
# between the two builds cannot become an ABI problem at run time.
STATIC_LIBSTDCXX=1

# ---- numerical libraries --------------------------------------------------
# ARM Performance Libraries: the version fetched from developer.arm.com.
ARMPL_VERSION=26.07
# OpenBLAS built from source where a serial, locking-safe build is needed.
OPENBLAS_VERSION=0.3.29

## Allocator shipped BESIDE the binaries (bin/../lib and the wrapper's malloc
## dir), never linked: inla.run preloads it only when INLA_MALLOC_LIB asks.
MIMALLOC_VERSION=v3.5.0
# Intel MKL comes from Intel's own apt/yum repository, always the current
# release; there is no version to pin here.

# ---- portability floors ---------------------------------------------------
# glibc floor of the classic Linux bundles (manylinux_2_28 container).
GLIBC_FLOOR_CLASSIC=2.28
# glibc floor accepted for the modern bundles (built on the runner itself).
GLIBC_FLOOR_MODERN=2.39
# Oldest macOS the mac bundles must load on. NOTE: Homebrew's libraries are
# built for the OS of the build machine, so the real floor of a mac bundle
# can be higher than this; the packaging step reports what it ended up as.
MACOS_DEPLOYMENT_TARGET=11.0
