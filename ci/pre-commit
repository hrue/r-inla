#!/bin/sh
## Keep rinla/DESCRIPTION's Version in step with the commit being made.
##
## The version is the date of the CODE (the commit), not of the build or the
## install: that is what makes it answer "which sources is this", so two people
## installing the same commit report the same number. Nothing derives it
## automatically, so it used to be bumped by hand and drift; the r-package
## workflow then fails on "Version is stale", after the push, which is a slow
## way to find out. This does the bump at commit time instead.
##
## bump-rinla-version.sh is a no-op when the version already matches, so this
## costs nothing on the commits that do not need it.
##
## Install once per clone:
##     ln -sf ../../ci/pre-commit .git/hooks/pre-commit
set -e
root=$(git rev-parse --show-toplevel)

## Nothing below should run while a merge or rebase is replaying commits: the
## version there belongs to those commits, and regenerating a directory
## mid-replay produces conflicts in files the user never touched. Checked
## first so it covers the package sync as well as the version bump.
if [ -e "$root/.git/MERGE_HEAD" ] || [ -d "$root/.git/rebase-merge" ] \
   || [ -d "$root/.git/rebase-apply" ]; then
    exit 0
fi

## Keep package/ in step with rinla/, on EVERY branch.
##
## package/ is rinla/ with the symlinks resolved into real files. It is the
## only way a Windows user can install from this repository: tar.exe cannot
## create a symlink, fails on all 211 of them and then aborts, so
## install_github() dies before it reaches any subdirectory.
##
## Being generated, it goes stale the moment rinla/ changes, or anything
## rinla/ links to, which includes every PDF under r-inla.org/doc. A stale
## copy is worse than none: it would quietly ship old code to exactly the
## users who have no other route to install.
##
## The r-package workflow verifies this too, but only on feature/ci and
## master, and only after a push. Doing it here means work on any branch
## cannot drift, and nobody editing a PDF has to know package/ exists.
## Same bargain the version bump below makes: regenerate, stage, say so.
if [ -x "$root/ci/sync-package.sh" ]; then
    ## rinla/ must be fully staged first. The sync copies the WORKING TREE, so
    ## an unstaged edit under rinla/ would be baked into package/ and staged,
    ## while the source of it stayed out of the commit. That produces a commit
    ## whose generated half does not match its own sources, and the CI guard
    ## then reports package/ as out of date on a tree where it looks correct
    ## locally. Refusing here is the only point where the two halves can still
    ## be kept together.
    if ! git diff --quiet -- "$root/rinla"; then
        echo "pre-commit: rinla/ has unstaged changes, so package/ cannot be" >&2
        echo "            generated consistently with this commit:" >&2
        git diff --name-only -- "$root/rinla" | sed 's/^/              /' >&2
        echo "            stage them (git add rinla/...) or stash them, then commit." >&2
        exit 1
    fi
    bash "$root/ci/sync-package.sh" >/dev/null || exit 1
    if [ -n "$(git status --porcelain -- "$root/package")" ]; then
        ## -A, not plain add: rinla/ can lose files as well as gain them, and
        ## a deletion that never reaches package/ leaves it shipping a file
        ## that no longer exists.
        git add -A "$root/package"
        echo "pre-commit: package/ regenerated from rinla/ and staged"
    fi
fi

## master only. The version is a RELEASE fact: it says which day's code a
## release contains, and releases are cut from master. Bumping it on every
## branch made it move on every commit, which meant nothing and made the number
## impossible to reason about. Work on feature/ci leaves DESCRIPTION alone; the
## version is set when the work reaches master.
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
[ "$branch" = "master" ] || exit 0

## bash, not sh: the script uses "set -o pipefail", which dash rejects.
##
## Config/INLA/BinaryVersion is no longer decided here. It used to move only
## when gmrflib/ or inlaprog/ were staged, so that an R-only fix did not force
## a binary release; the cost was two similar-looking dates that disagreed and
## nobody could say which identified what. The script now keeps it equal to
## Version, so one number identifies the R package and the binary together.
## No --now: the version is NOT the date of this commit. It belongs to the
## last release and changes only when a release is cut, by tagging or by
## ci/bump-rinla-version.sh --release. Called with no flags this only keeps
## Config/INLA/BinaryVersion equal to Version.
bash "$root/ci/bump-rinla-version.sh" || exit 1

## Only stage it when it actually changed, so an unrelated commit does not
## silently acquire DESCRIPTION.
if ! git diff --quiet -- "$root/rinla/DESCRIPTION"; then
    git add "$root/rinla/DESCRIPTION"
    echo "pre-commit: rinla/DESCRIPTION Version bumped and staged"
fi
