#!/bin/sh
## Keep rinla/DESCRIPTION's Version in step with the commit being made.
##
## The version is the date of the CODE (the commit), not of the build or the
## install: that is what makes it answer "which sources is this", so two people
## installing the same commit report the same number. Nothing derives it
## automatically, so it used to be bumped by hand and drift; the r-package
## workflow then fails on "Version is stale", after the push, which is a slow
## way to find out. This does the bump at commit time instead.
##
## bump-rinla-version.sh is a no-op when the version already matches, so this
## costs nothing on the commits that do not need it.
##
## Install once per clone:
##     ln -sf ../../ci/pre-commit .git/hooks/pre-commit
set -e
root=$(git rev-parse --show-toplevel)

## master only. The version is a RELEASE fact: it says which day's code a
## release contains, and releases are cut from master. Bumping it on every
## branch made it move on every commit, which meant nothing and made the number
## impossible to reason about. Work on feature/ci leaves DESCRIPTION alone; the
## version is set when the work reaches master.
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
[ "$branch" = "master" ] || exit 0

## Skip while a merge/rebase is in progress: the version there belongs to the
## commits being replayed, and rewriting it mid-merge produces conflicts in a
## file the user never touched.
if [ -e "$root/.git/MERGE_HEAD" ] || [ -d "$root/.git/rebase-merge" ] || [ -d "$root/.git/rebase-apply" ]; then
    exit 0
fi

## Does this commit change the SOLVER? Config/INLA/BinaryVersion says which
## binary release the R package needs, and it must move exactly when the C
## sources do: leaving it behind hands users a binary older than the code, and
## moving it on every R edit would force a pointless binary release. So decide
## from what is staged. gmrflib/ and inlaprog/ are what the binary is built
## from; ci/ and rinla/ are not.
if git diff --cached --name-only | grep -qE '^(gmrflib|inlaprog)/'; then
    binflag=--binary
else
    binflag=
fi

## bash, not sh: the script uses "set -o pipefail", which dash rejects.
bash "$root/ci/bump-rinla-version.sh" --now $binflag || exit 1

## Only stage it when it actually changed, so an unrelated commit does not
## silently acquire DESCRIPTION.
if ! git diff --quiet -- "$root/rinla/DESCRIPTION"; then
    git add "$root/rinla/DESCRIPTION"
    echo "pre-commit: rinla/DESCRIPTION Version bumped and staged"
fi
